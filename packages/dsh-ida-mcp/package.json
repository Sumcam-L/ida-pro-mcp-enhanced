{
  "name": "dsh-ida-mcp",
  "version": "0.2.0",
  "description": "IDA Pro MCP bridge for DeepSeek Harness: connects the local ida-pro-mcp broker into ctx.tools as native mcp__ida__* tools (decompile, xrefs, survey, rename, ...)",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.1 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "ida",
    "ida-pro",
    "mcp",
    "reverse-engineering",
    "decompiler"
  ],
  "homepage": "https://github.com/Sumcam-L/ida-pro-mcp-enhanced/tree/main/packages/dsh-ida-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumcam-L/ida-pro-mcp-enhanced.git",
    "directory": "packages/dsh-ida-mcp"
  },
  "bugs": {
    "url": "https://github.com/Sumcam-L/ida-pro-mcp-enhanced/issues"
  },
  "license": "MIT"
}
